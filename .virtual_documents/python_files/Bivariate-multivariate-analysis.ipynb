import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt


tips=sns.load_dataset('tips')



tips.head()


flights=sns.load_dataset('flights')


flights.head()


iris=sns.load_dataset('iris')


iris.head()


titanic=pd.read_csv("../data/Titanic-Dataset.csv")


titanic.head()








sns.scatterplot(data=tips, x='total_bill', y='tip',hue="sex",style="smoker",size="size")





sns.barplot(data=titanic,x='Pclass',y='Fare',hue="Sex")





sns.boxplot(data=titanic,x='Sex',y='Age',hue="Survived")
#here the surviavl chance of males is between 20-35
#here the survival chance of females is between 25-40 


sns.histplot(
    data=titanic,
    x='Age',
    hue='Survived',
    kde=True,
    
)

plt.show()

#we did three observation here that 
#the survival chance of kids is more that not survived
#the survival chance of middle age is less than not survived
#the survival chance of old age is less than not survived





sns.heatmap(pd.crosstab(titanic["Pclass"],titanic["Survived"]))


pd.crosstab(titanic["Pclass"],titanic["Survived"])


titanic.groupby("Pclass")["Survived"].mean() * 100


sns.barplot(titanic.groupby("Pclass")["Survived"].mean() * 100)


pd.crosstab(titanic["Sex"],titanic["Survived"])


pd.crosstab(titanic["Parch"],titanic["Survived"])





sns.clustermap(pd.crosstab(titanic["Parch"],titanic["Survived"]))





sns.pairplot(iris,hue="species")
















import pandas as pd
import requests
from bs4 import BeautifulSoup


headers = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/139.0.0.0 Safari/537.36"
}
url='https://www.ambitionbox.com/list-of-companies?campaign=desktop_nav&page=1'
webpage=requests.get(url,headers=headers)


soup = BeautifulSoup(webpage.text, "html.parser")

print(soup.title.text)


len(soup.find_all("h2"))


for tag in soup.find_all("h2"):
    print(tag.text.strip())


for para in soup.find_all("p"):
    print(para.text.strip())


rating = soup.select(
    "div.companyCardWrapper__companyRatingWrapper > div > div > div > div"
)

for r in rating:
    print(r.get_text(strip=True))



rating = soup.find_all(
    class_="companyCardWrapper__companyRatingWrapper"
    
)

for r in rating:
    print(r.get_text(strip=True))





cards = soup.select("div.companyCardWrapper")


for card in cards:
    company = card.select_one("h2")
    rating = card.select_one(
        "div.companyCardWrapper__companyRatingWrapper > div > div"
    )

    if company and rating:
        print(
            company.get_text(strip=True),
            rating.get_text(strip=True)
        )
